# 复制为 .env 后按云端环境修改，docker compose 会自动读取
POSTGRES_DB=pandora
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# backend 连接数据库使用；主机名必须是 compose 服务名 postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/pandora
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me

# 管理端初始密码与 JWT 签名密钥；JWT_SECRET 至少 32 字节
ADMIN_INIT_PASSWORD=change_me
JWT_SECRET=please-change-this-to-a-random-secret-at-least-32-bytes

# 可选：移动端 AI 地图分析需要配置，不配置时相关接口返回未启用
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
