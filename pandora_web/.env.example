# 用法：复制本文件为 .env.local，然后按后端实际情况改。
# 改完必须重启 npm run dev（Vite 只在启动时读环境变量）。

# 默认 true：纯前端演示，不连后端。
# 周四联调时改成 false，走真接口。
VITE_USE_MOCK=false

# 浏览器请求前缀。保持 /api 即可，由 vite.config.ts 的 proxy 转发到后端，
# 这样浏览器不会跨域（CORS），最省事。
VITE_API_BASE=/api

# 后端真实地址（只给 vite 代理用，浏览器看不到这个值）。
# 后端端口不是 8080 就改这里。
VITE_PROXY_TARGET=http://localhost:8080
