{
  "baseUrl": "http://localhost:8080/api",
  "description": "认证接口请求/响应样例。除登录、刷新外均需携带 Authorization: Bearer <accessToken>。",
  "cases": [
    {
      "name": "登录成功",
      "request": {
        "method": "POST",
        "path": "/auth/login",
        "headers": { "Content-Type": "application/json" },
        "body": { "username": "admin", "password": "<ADMIN_INIT_PASSWORD>" }
      },
      "response": {
        "status": 200,
        "body": {
          "code": 0,
          "message": "ok",
          "data": {
            "accessToken": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.signature",
            "refreshToken": "b7d4c3f0e1a24c8f9b6d5e2a1c0f3b7d9e8a6c4f2b1d0e3a5c7f9b8d6e4a2c1f",
            "tokenType": "Bearer",
            "expiresIn": 7200,
            "user": {
              "id": 1,
              "username": "admin",
              "realName": "系统管理员",
              "role": "ADMIN",
              "departmentId": null,
              "teamId": null
            }
          }
        }
      }
    },
    {
      "name": "登录成功（员工）",
      "request": {
        "method": "POST",
        "path": "/auth/login",
        "headers": { "Content-Type": "application/json" },
        "body": { "username": "zhangsan", "password": "secret" }
      },
      "response": {
        "status": 200,
        "body": {
          "code": 0,
          "message": "ok",
          "data": {
            "accessToken": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMiJ9.signature",
            "refreshToken": "6f1a9c2e4b8d0f3a5c7e9b1d2f4a6c8e0b3d5f7a9c1e2b4d6f8a0c3e5b7d9f1a",
            "tokenType": "Bearer",
            "expiresIn": 7200,
            "user": {
              "id": 12,
              "username": "zhangsan",
              "realName": "张三",
              "role": "EMPLOYEE",
              "departmentId": 3,
              "teamId": 8
            }
          }
        }
      }
    },
    {
      "name": "用户名或密码错误",
      "request": {
        "method": "POST",
        "path": "/auth/login",
        "headers": { "Content-Type": "application/json" },
        "body": { "username": "zhangsan", "password": "wrong" }
      },
      "response": {
        "status": 401,
        "body": { "code": 40101, "message": "用户名或密码错误", "data": null }
      }
    },
    {
      "name": "连续失败达到阈值后锁定",
      "request": {
        "method": "POST",
        "path": "/auth/login",
        "headers": { "Content-Type": "application/json" },
        "body": { "username": "zhangsan", "password": "wrong" }
      },
      "response": {
        "status": 423,
        "body": { "code": 40103, "message": "账号已锁定，请稍后重试", "data": null }
      },
      "notes": "第 5 次失败仍返回 401/40101，此后在锁定期内返回 423/40103；阈值与时长取自 system_configs 的 login_max_failures 与 login_lock_minutes。"
    },
    {
      "name": "停用账号登录",
      "request": {
        "method": "POST",
        "path": "/auth/login",
        "headers": { "Content-Type": "application/json" },
        "body": { "username": "disabled1", "password": "secret" }
      },
      "response": {
        "status": 401,
        "body": { "code": 40103, "message": "账号已锁定或停用", "data": null }
      }
    },
    {
      "name": "登录参数校验失败",
      "request": {
        "method": "POST",
        "path": "/auth/login",
        "headers": { "Content-Type": "application/json" },
        "body": { "username": "", "password": "" }
      },
      "response": {
        "status": 400,
        "body": {
          "code": 40001,
          "message": "username: 用户名不能为空; password: 密码不能为空",
          "data": null
        }
      }
    },
    {
      "name": "刷新令牌",
      "request": {
        "method": "POST",
        "path": "/auth/refresh",
        "headers": { "Content-Type": "application/json" },
        "body": { "refreshToken": "b7d4c3f0e1a24c8f9b6d5e2a1c0f3b7d9e8a6c4f2b1d0e3a5c7f9b8d6e4a2c1f" }
      },
      "response": {
        "status": 200,
        "body": {
          "code": 0,
          "message": "ok",
          "data": {
            "accessToken": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.new-signature",
            "refreshToken": "2c4e6a8b0d1f3a5c7e9b2d4f6a8c0e1b3d5f7a9c2e4b6d8f0a1c3e5b7d9f2a4c",
            "tokenType": "Bearer",
            "expiresIn": 7200
          }
        }
      },
      "notes": "刷新成功后旧刷新令牌立即撤销，客户端必须保存本次返回的新 refreshToken。"
    },
    {
      "name": "刷新令牌无效或已撤销",
      "request": {
        "method": "POST",
        "path": "/auth/refresh",
        "headers": { "Content-Type": "application/json" },
        "body": { "refreshToken": "revoked-token" }
      },
      "response": {
        "status": 401,
        "body": { "code": 40102, "message": "访问令牌无效或过期", "data": null }
      }
    },
    {
      "name": "登出",
      "request": {
        "method": "POST",
        "path": "/auth/logout",
        "headers": { "Content-Type": "application/json" },
        "body": { "refreshToken": "2c4e6a8b0d1f3a5c7e9b2d4f6a8c0e1b3d5f7a9c2e4b6d8f0a1c3e5b7d9f2a4c" }
      },
      "response": {
        "status": 200,
        "body": { "code": 0, "message": "ok", "data": null }
      },
      "notes": "重复调用同一刷新令牌同样返回成功；未知或已撤销令牌也按幂等处理。"
    },
    {
      "name": "当前账号（管理员）",
      "request": {
        "method": "GET",
        "path": "/auth/me",
        "headers": { "Authorization": "Bearer <accessToken>" }
      },
      "response": {
        "status": 200,
        "body": {
          "code": 0,
          "message": "ok",
          "data": {
            "id": 1,
            "username": "admin",
            "realName": "系统管理员",
            "role": "ADMIN",
            "departmentId": null,
            "teamId": null,
            "permissions": [
              "user:manage",
              "org:manage",
              "role:manage",
              "config:manage",
              "audit:read",
              "content:read",
              "company-matter:manage"
            ]
          }
        }
      },
      "notes": "管理员不包含 task:dispatch、task:execute、task:self。"
    },
    {
      "name": "当前账号（员工）",
      "request": {
        "method": "GET",
        "path": "/auth/me",
        "headers": { "Authorization": "Bearer <accessToken>" }
      },
      "response": {
        "status": 200,
        "body": {
          "code": 0,
          "message": "ok",
          "data": {
            "id": 12,
            "username": "zhangsan",
            "realName": "张三",
            "role": "EMPLOYEE",
            "departmentId": 3,
            "teamId": 8,
            "permissions": [
              "log:write",
              "log:comment",
              "task:execute",
              "task:self",
              "content:read"
            ]
          }
        }
      }
    },
    {
      "name": "访问令牌无效或过期",
      "request": {
        "method": "GET",
        "path": "/auth/me",
        "headers": { "Authorization": "Bearer expired-or-invalid-token" }
      },
      "response": {
        "status": 401,
        "body": { "code": 40102, "message": "访问令牌无效或过期", "data": null }
      }
    },
    {
      "name": "账号在令牌有效期内被停用",
      "request": {
        "method": "GET",
        "path": "/auth/me",
        "headers": { "Authorization": "Bearer <accessToken>" }
      },
      "response": {
        "status": 401,
        "body": { "code": 40103, "message": "账号已锁定或停用", "data": null }
      },
      "notes": "每次请求都会查询用户状态，停用或锁定立即生效；重新启用后原访问令牌恢复可用。"
    }
  ]
}
